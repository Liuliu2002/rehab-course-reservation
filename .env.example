# Production must provide strong, unique values. Do not commit the real .env file.
REHAB_DB_URL=jdbc:mysql://localhost:3306/rehab_course?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
REHAB_DB_USERNAME=rehab_app
REHAB_DB_PASSWORD=684564
REHAB_REDIS_HOST=localhost
REHAB_REDIS_PORT=6379
REHAB_RABBITMQ_HOST=localhost
REHAB_RABBITMQ_PORT=5672
REHAB_RABBITMQ_USERNAME=guest
REHAB_RABBITMQ_PASSWORD=guest
REHAB_JWT_SECRET=replace-with-at-least-32-random-characters
REHAB_ACCESS_TOKEN_TTL_MINUTES=15
REHAB_REFRESH_TOKEN_TTL_DAYS=7
REHAB_MAX_SESSION_TTL_DAYS=30
# HTTPS production deployments should set this to true.
REHAB_REFRESH_COOKIE_SECURE=false
REHAB_WS_ALLOWED_ORIGINS=https://rehab.example.com
