# 将本文件内容合并到 nginx.conf 的 http { server { ... } } 中即可。
# 示例访问地址：http://localhost/rehab/

location /rehab/ {
    alias html/rehab-front/;
    index index.html;
    try_files $uri $uri/ /rehab/index.html;
}

location /student/ {
    proxy_pass http://127.0.0.1:8080/student/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}

location /admin/ {
    proxy_pass http://127.0.0.1:8080/admin/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}

location /ws/appointment {
    proxy_pass http://127.0.0.1:8080/ws/appointment;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
}
